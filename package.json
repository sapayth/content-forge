{
  "name": "content-forge",
  "version": "1.8.0",
  "description": "Generate fake/dummy posts, pages, users, comments for development/testing in WordPress.",
  "main": "src/pages-posts-app.jsx",
  "scripts": {
    "start": "node init && webpack --mode development --watch",
    "build": "node init && webpack --mode production",
    "build:css": "node init && webpack --mode production",
    "build:pages-posts": "node init && webpack --config webpack.config.js --env entry=pages-posts.jsx --env output=assets/js/pagesPosts.js --mode production",
    "release": "scripts/package.sh",
    "zip": "scripts/package.sh",
    "howto": "wp-scripts test-playwright --config playwright.howto.config.js",
    "wp-env": "wp-env",
    "test:e2e": "wp-scripts test-playwright",
    "screenshots": "wp-scripts test-playwright --config playwright.screenshots.config.js"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.24.0",
    "@wordpress/components": "^29.10.0",
    "@wordpress/element": "^6.24.0",
    "@wordpress/i18n": "^5.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@wordpress/e2e-test-utils-playwright": "^1.54.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^31.8.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.4.21",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.19",
    "webpack": "^5.112.1",
    "webpack-cli": "^5.1.4"
  }
}
