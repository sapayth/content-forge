{
  "name": "content-forge",
  "version": "1.6.0",
  "description": "Generate fake/dummy posts, pages, users, comments for development/testing in WordPress.",
  "main": "src/pages-posts-app.jsx",
  "scripts": {
    "start": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:css": "webpack --mode production",
    "build:pages-posts": "webpack --config webpack.config.js --env entry=pages-posts.jsx --env output=assets/js/pagesPosts.js --mode production",
    "release": "scripts/package.sh",
    "zip": "scripts/package.sh",
    "howto": "wp-scripts test-playwright --config playwright.howto.config.js",
    "wp-env": "wp-env",
    "test:e2e": "wp-scripts test-playwright"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.24.0",
    "@wordpress/components": "^29.10.0",
    "@wordpress/element": "^6.24.0",
    "@wordpress/i18n": "^5.24.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@playwright/test": "^1.64.1",
    "@wordpress/e2e-test-utils-playwright": "^3.1.0",
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^37.0.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.4.21",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^7.2.3"
  }
}
